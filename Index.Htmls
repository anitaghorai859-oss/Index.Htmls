            opacity: 0.85;
        }

        #start-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.96);
            color: #ff3300;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 999999;
            font-size: 22px;
            font-weight: bold;
            text-align: center;
            cursor: pointer;
            text-shadow: 0 0 10px #ff3300;
        }

        .floating-notification {
            display: none;
            position: fixed;
            background: rgba(15, 15, 15, 0.98);
            border: 2px solid #ff0000;
            color: #fff;
            padding: 12px 18px;
            border-radius: 8px;
            box-shadow: 0 0 25px rgba(255, 0, 0, 0.9);
            width: 82%;
            max-width: 360px;
            z-index: 999;
            font-size: 13px;
        }

        .floating-notification .sender {
            color: #ffff00;
            font-weight: bold;
            display: block;
            margin-bottom: 4px;
        }

        .middle-alert {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(15, 15, 15, 0.98);
            border: 3px solid #ff3300;
            color: #fff;
            padding: 20px 25px;
            border-radius: 12px;
            box-shadow: 0 0 35px rgba(255, 51, 0, 0.95);
            width: 85%;
            max-width: 380px;
            z-index: 9999;
            text-align: center;
            animation: fireGlow 1s infinite alternate;
        }

        @keyframes fireGlow {
            0% { box-shadow: 0 0 15px #ff3300, 0 0 30px #ff6600; }
            100% { box-shadow: 0 0 35px #ff0000, 0 0 60px #ff9900; }
        }

        .middle-alert .alert-title {
            color: #ff3300;
            font-weight: bold;
            font-size: 16px;
            display: block;
            margin-bottom: 8px;
            text-shadow: 0 0 8px #ff3300;
        }

        .middle-alert .alert-text {
            color: #ffcc00;
            font-size: 15px;
            font-weight: bold;
            line-height: 1.4;
        }

        #hacked-screen {
