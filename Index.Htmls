        let count = 0;
        const totalLines = 13000;
        let speed = 15; 
        let audioCtx, osc, gainNode, sirenInterval, isSirenActive = false;

        function getRandomHex() {
            return '0x' + Math.floor(Math.random()*16777215).toString(16).toUpperCase();
        }

        function generateRandomLine() {
            const randomAction = actions[Math.floor(Math.random() * actions.length)];
            const randomModule = modules[Math.floor(Math.random() * modules.length)];
            const hexCode = getRandomHex();
            const percentage = Math.floor(Math.random() * 100);
            
            return `[${hexCode}] > ${randomAction} -> ${randomModule} [${percentage}%]`;
        }

        // ব্রাউজারের ডাইরেক্ট অডিও ইঞ্জিন দিয়ে উচ্চ শব্দের সাইরেন জেনারেটর
        function playHighSiren() {
            if (isSirenActive) return;
            isSirenActive = true;

            try {
                const AudioCtxClass = window.AudioContext || window.webkitAudioContext;
                audioCtx = new AudioCtxClass();

                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }

                osc = audioCtx.createOscillator();
                gainNode = audioCtx.createGain();

                osc.type = 'sawtooth';
                gainNode.gain.setValueAtTime(1.0, audioCtx.currentTime);

                osc.connect(gainNode);
                gainNode.connect(audioCtx.destination);
                osc.start();

                let high = false;
                sirenInterval = setInterval(() => {
                    if (audioCtx && osc) {
                        osc.frequency.setValueAtTime(high ? 1300 : 550, audioCtx.currentTime);
                        high = !high;
                    }
                }, 180);
            } catch (e) {
                console.log("Audio exception: ", e);
            }
        }
